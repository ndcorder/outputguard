  {
    "name": "cross-format",
    "schema": {
      "properties": {
        "value": {
          "type": "integer"
        }
      }
    },
    "stages": [
      {
        "checks": [
          {
            "text": "{\"value\":1}",
            "expected": {
              "valid": true,
              "data": {
                "value": 1
              },
              "paths": []
            }
          }
        ]
      },
      {
        "checks": [
          {
            "text": "{\"value\":1}",
            "expected": {
              "valid": false,
              "data": {
                "value": 1
              },
              "paths": [
                "$.value"
              ]
            }
          },
          {
            "text": "value: 1",
            "format": "yaml",
            "expected": {
              "valid": false,
              "data": {
                "value": 1
              },
              "paths": [
                "$.value"
              ]
            }
          },
          {
            "text": "value: text",
            "format": "yaml",
            "expected": {
              "valid": true,
              "data": {
                "value": "text"
              },
              "paths": []
            }
          },
          {
            "text": "value=1",
            "format": "toml",
            "expected": {
              "valid": false,
              "data": {
                "value": 1
              },
              "paths": [
                "$.value"
              ]
            }
          },
          {
            "text": "value=\"text\"",
            "format": "toml",
            "expected": {
              "valid": true,
              "data": {
                "value": "text"
              },
              "paths": []
            }
          },
          {
            "text": "{'value':1}",
            "format": "python",
            "expected": {
              "valid": false,
              "data": {
                "value": 1
              },
              "paths": [
                "$.value"
              ]
            }
          },
          {
            "text": "{'value':'text'}",
            "format": "python",
            "expected": {
              "valid": true,
              "data": {
                "value": "text"
              },
              "paths": []
            }
          }
        ],
        "changes": [
          {
            "path": [
              "properties",
              "value",
              "type"
            ],
            "value": "string"
          }
        ]
      }
    ]
  }
